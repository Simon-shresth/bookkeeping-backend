# PostgreSQL connection (from Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgres://user:password@host:5432/postgres

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Only needed for older Supabase projects still using the legacy shared-secret
# (HS256) signing method — Project Settings -> API -> JWT Settings. New
# projects sign tokens asymmetrically and are verified automatically via
# Supabase's public keys (SUPABASE_URL above), so this can be left blank.
SUPABASE_JWT_SECRET=
# Service role key (Project Settings -> API -> service_role) — grants admin
# rights over Supabase Auth (used only to invite teammates). NEVER expose
# this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Where invite emails send people (the frontend's base URL, no trailing slash).
# Defaults to CORS_ORIGIN if unset.
FRONTEND_URL=http://localhost:5173

# Set to 'true' in production behind HTTPS (Render sets this automatically via NODE_ENV)
NODE_ENV=development
